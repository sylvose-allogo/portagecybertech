						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "grant_type",
							"value": "urn:ietf:params:oauth:grant-type:token-exchange",
							"type": "text"
						},
						{
							"key": "subject_token",
							"value": "{{subjectToken}}",
							"type": "text"
						},
						{
							"key": "subject_token_type",
							"value": "{{subjectTokenType}}",
							"type": "text"
						},
