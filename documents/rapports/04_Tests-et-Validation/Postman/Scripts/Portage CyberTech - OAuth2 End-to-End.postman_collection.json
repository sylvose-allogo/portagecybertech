		{
			"name": "05 - Authorization Server - RFC 8693 token exchange",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('RFC 8693 exchanges the source token', function () {",
							"  pm.response.to.have.status(200);",
							"  const body = pm.response.json();",
							"  pm.expect(body.token_type).to.eql('Bearer');",
							"  pm.expect(body.scope).to.include(pm.environment.get('scope'));",
							"  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
							"  const parts = body.access_token.split('.');",
							"  pm.expect(parts).to.have.lengthOf(3);",
							"  pm.environment.set('accessToken', body.access_token);",
							"  const signature = parts[2];",
							"  const altered = (signature.charAt(0) === 'A' ? 'B' : 'A') + signature.substring(1);",
							"  pm.environment.set('tamperedToken', parts[0] + '.' + parts[1] + '.' + altered);",
							"});"
						]
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "username",
							"value": "{{clientId}}",
							"type": "string"
						},
						{
							"key": "password",
							"value": "{{clientSecret}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
