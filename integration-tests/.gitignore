# eclipse specific git ignore
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.buildpath

# ignore caches and things from deploy 
war/WEB-INF/deploy/ 
war/WEB-INF/classes/ 

# ignore generated class files
*.class

# Package Files
*.jar 
*.war 
*.ear  

# ignore generated folders
target/**
build/**
bin/**
tmp/**
log/**
.settings/**
.metadata/**

# ignore test files
*.testsettings

# ignore Maven files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
release.properties

# ignore external tool builders
.externalToolBuilders/

# ignore generated by JIRA plugin
**/atlassian-ide-plugin.xml

# ignore locally stored "Eclipse launch configurations"
*.launch

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml 
hs_err_pid*
/authorization-server/target/
/.idea/
/integration-tests/target/
