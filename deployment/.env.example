# Copy this file to deployment/.env and replace the secret before starting.
BIND_ADDRESS=127.0.0.1
AUTHORIZATION_SERVER_HOST_PORT=9090
RESOURCE_SERVER_HOST_PORT=8080
OAUTH_CLIENT_ID=agent-client
OAUTH_CLIENT_SECRET=replace-with-a-long-random-secret

# Keep the issuer URL identical in both services and reachable from both
# containers. The default is the internal Compose service address.
OAUTH_ISSUER=http://authorization-server:9090
OAUTH_API_AUDIENCE=http://localhost:8080/api
